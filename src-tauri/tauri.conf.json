{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plagx Writing Companion",
  "version": "1.0.0",
  "identifier": "com.plagiarismcheckerx.writingcompanion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Plagx Writing Companion", "width": 420, "height": 820, "minWidth": 360, "minHeight": 560, "center": true }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.crossref.org ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "Plagiarism Checker X"
  }
}
